{
  "name": "rogueiq-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "account_id": "40b6df49dccc6011e04aae38bfa6a209",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "rogueiq.com", "custom_domain": true }, { "pattern": "www.rogueiq.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "services": [{ "binding": "FEED", "service": "rogueiq-feed" }, { "binding": "TOOLS", "service": "rogueiq-tools" }],
  // PREVIEW ONLY: `wrangler deploy --env preview` -> "rogueiq-site-preview" on workers.dev, no custom domains,
  // wired to rogueiq-feed-preview. The worker adds X-Robots-Tag: noindex to every preview response.
  "env": { "preview": {
    "name": "rogueiq-site-preview", "workers_dev": true, "routes": [], "preview_urls": false,
    "vars": { "PREVIEW": "1" },
    "services": [{ "binding": "FEED", "service": "rogueiq-feed-preview" }, { "binding": "TOOLS", "service": "rogueiq-tools" }]
  } }
}
